# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kinal_inventario?schema=public"

# --- Servidor ---
PORT=3000

# --- Seguridad ---
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"
JWT_EXPIRES_IN="8h"

# --- Usuario administrador (login de la app) ---
# El valor de ADMIN_PASSWORD_HASH se genera con el script:
#   npx ts-node src/scripts/generarHash.ts tu_password
ADMIN_EMAIL="admin@kinal.edu.gt"
ADMIN_PASSWORD_HASH="$2a$10$CwTycUXWue0Thq9StjUM0uJ8Q6gW5vNy5rMKZeCbzoZJa1LcXQMy."
